{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CV4_HOME>/tools/hooks/dispatch.sh\" claude SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CV4_HOME>/tools/hooks/dispatch.sh\" claude UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CV4_HOME>/tools/hooks/dispatch.sh\" claude PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CV4_HOME>/tools/hooks/dispatch.sh\" claude PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CV4_HOME>/tools/hooks/dispatch.sh\" claude Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CV4_HOME>/tools/hooks/dispatch.sh\" claude SessionEnd",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CV4_HOME>/tools/hooks/dispatch.sh\" claude PreCompact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
